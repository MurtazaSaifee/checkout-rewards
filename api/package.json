{
  "name": "@checkout-rewards/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "perf:checkout": "tsx perf/checkout-throughput.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-openapi-validator": "5.6.2",
    "pg": "8.23.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/autocannon": "7.12.7",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "autocannon": "8.0.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
